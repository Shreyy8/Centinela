{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "project": {
    "name": "Centinela",
    "internal_name": "Bayora",
    "description": "Adversarial AI Safety Testing, Sandboxed Red/Blue Team Evaluation, and Forensic Certification Platform",
    "repository_url": "https://github.com/Shreyy8/Centinela.git",
    "tech_stack": {
      "frontend": ["React 19", "TanStack Start", "TanStack Router", "TanStack Query", "Tailwind CSS v4", "Vite 7"],
      "backend": ["Python 3.11", "FastAPI", "Uvicorn", "AIOKafka", "Pydantic v2"],
      "ml_frameworks": ["PyTorch", "Hugging Face Transformers", "PEFT (LoRA)", "LiteLLM", "Sentence-Transformers"],
      "message_broker": "Apache Kafka (Confluent Platform 7.5.0 / Strimzi K8s Operator)",
      "databases": ["PostgreSQL 16", "MongoDB 7+"],
      "infrastructure": ["Docker Compose", "Kubernetes", "gVisor (runsc)", "Istio Service Mesh", "Falco eBPF", "Terraform AWS EKS"]
    }
  },
  "microservices": [
