# Grafana Dashboard Definition (Simplified)
{
  "title": "Bayora Security Dashboard",
  "panels": [
    {
      "title": "Active Sessions",
      "type": "stat",
      "targets": [{"expr": "bayora_active_sessions"}]
    },
    {
      "title": "Isolation Violation Rate",
      "type": "graph",
      "targets": [{"expr": "rate(bayora_security_violations_total[5m])"}]
    },
    {
      "title": "Inference Latency (p95)",
      "type": "heatmap",
      "targets": [{"expr": "histogram_quantile(0.95, rate(bayora_inference_latency_seconds_bucket[5m]))"}]
    }
  ]
}
